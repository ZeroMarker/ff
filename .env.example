# 复制为 .env 并按需修改；systemd 通过 EnvironmentFile 读取
# 监听地址（本机 Caddy 反代时保持 127.0.0.1）
HOST=127.0.0.1
PORT=8345

# 数据目录
VIDEOS_DIR=/home/ubuntu/ff/videos
OUTPUT_DIR=/home/ubuntu/ff/output

# 并发 ffmpeg 任务上限（CPU 视频编码很吃资源，建议 1-2）
MAX_CONCURRENCY=2

# 单文件上传上限（MB）
MAX_UPLOAD_MB=8192

# 可选：设置后所有 /api/* 请求需携带 x-auth-token 头
# AUTH_TOKEN=请改成随机长字符串

# 可选：自定义 ffmpeg 路径（如编译版）
# FFMPEG_PATH=/usr/local/bin/ffmpeg
# FFPROBE_PATH=/usr/local/bin/ffprobe
# 视频不走网页上传：直接放到 VIDEOS_DIR 目录即可；如需临时开放上传设为 1
UPLOAD_ENABLED=0
